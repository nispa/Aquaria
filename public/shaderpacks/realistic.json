{
  "id": "realistic",
  "name": "Realistic",
  "description": "Soft shadows, water reflections, refractive bubbles, ambient occlusion, volumetric light shafts and depth of field.",
  "lighting": {
    "shadows": { "enabled": true, "mapSize": 2048 },
    "environment": true,
    "exposure": 1
  },
  "bubbles": "refractive",
  "lightShafts": false,
  "passes": [
    { "effect": "ambient-occlusion", "params": { "radius": 0.35, "intensity": 0.75 } },
    { "effect": "volumetric-light", "params": { "exposure": 0.45 } },
    {
      "effect": "depth-of-field",
      "params": { "focus": 1.8, "aperture": 0.0025, "maxBlur": 0.004 }
    },
    { "effect": "bloom", "params": { "strength": 0.32 } },
    { "effect": "finish", "params": { "vignette": 0.4 } }
  ]
}
